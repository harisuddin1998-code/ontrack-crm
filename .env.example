# .env.example
# Copy to .env and fill in real values. NEVER commit a filled-in .env.

# Flask Configuration
FLASK_APP=src/app.py
FLASK_ENV=production
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/on_track_db
# Or for SQLite (development)
# DATABASE_URL=sqlite:///instance/management.db

# Email Configuration
MAIL_SERVER=mail.example.com
MAIL_PORT=26
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=your-mail-user@example.com
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_SENDER=your-mail-user@example.com

# GPS API Configuration
GPS_API_URL=http://gps-host.example.com:8080/api/api.php
GPS_API_KEY=your-gps-api-key
GPS_SYNC_INTERVAL=300

# Celery (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Cache
CACHE_REDIS_URL=redis://localhost:6379/2

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour

# Security
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
CORS_ORIGINS=*

# Background scheduler (GPS sync, fuel rates, AMC snapshot, month-end email).
# It runs inside the application, so exactly ONE process may own it - every
# worker running its own would email the month-end report to senior
# management once per worker. Serving with `gunicorn --preload` builds the
# app once before forking and satisfies that on its own; set this to false on
# any additional instance behind a load balancer.
SCHEDULER_ENABLED=true

# Internal Database (SQL Server)
INTERNAL_DB_SERVER=your-sql-server-host
INTERNAL_DB_USER=your-sql-user
INTERNAL_DB_PASSWORD=your-sql-password
INTERNAL_DB_DRIVER={ODBC Driver 17 for SQL Server}
INTERNAL_DB_NAME=master

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Upload Directory
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# PDF Generation
WKHTMLTOPDF_PATH=  # Path to wkhtmltopdf executable
